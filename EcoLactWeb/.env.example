APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecolactv1
DB_USERNAME=root
DB_PASSWORD=

# Usuario administrador inicial creado por AdminUserSeeder (solo valores de DESARROLLO).
# Defínelos en tu .env real con credenciales propias antes de sembrar en producción.
ECOLACT_ADMIN_USERNAME=admin
ECOLACT_ADMIN_PASSWORD="EcoLact#Dev2026"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps (módulo Zonas/Rutas/Recorridos de acopio). Sin esta clave, el
# mapa muestra un aviso pero la lista, la búsqueda y el registro manual de
# acopio siguen funcionando con normalidad. Ver docs/rutas-recorridos-acopio.md
# para los pasos de configuración en Google Cloud y las restricciones de
# dominio/API recomendadas para esta clave (es pública por diseño: se
# imprime en el HTML para que la Maps JavaScript API cargue en el navegador).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Punto de partida del mapa al asignar un proveedor sin ubicación previa
# (por defecto la ciudad de Puno). Ajústalo a la zona de Ecolácteos Huata.
GOOGLE_MAPS_DEFAULT_LAT=-15.8402
GOOGLE_MAPS_DEFAULT_LNG=-70.0219
GOOGLE_MAPS_DEFAULT_ZOOM=10

# Vista inicial del mapa de Zonas y del editor de delimitaciones (por defecto Huata).
GOOGLE_MAPS_ZONAS_LAT=-15.6144
GOOGLE_MAPS_ZONAS_LNG=-69.9711
GOOGLE_MAPS_ZONAS_ZOOM=12

# OCR local del ticket del analizador (Tesseract). Vacío = usar `tesseract` del PATH.
# Ej. Windows: TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_PATH=
TESSERACT_LANG=eng

EMPRESA_NOMBRE=EcoLact
