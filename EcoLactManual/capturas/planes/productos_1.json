  {"accion": "clic", "selector": "tr.recetas-detalle:visible button[type=submit]:has-text('Guardar precios')"},
  {"accion": "esperar", "ms": 3000},
  {"accion": "captura", "nombre": "prd_04_guardados", "medir": {"mensaje": "[role=alert]", "precios": "tr.recetas-detalle:visible [data-precios]"}, "leer": ["[role=alert]", "tr.recetas-detalle:visible [data-precios]"]}
 ]}
