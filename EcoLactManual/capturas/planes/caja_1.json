    "menu": "#ecolact-sidebar a[href$='/admin/caja']",
    "saldo": ".caja-saldo-icono >> xpath=ancestor::*[2]",
    "ojo": "[data-caja-ojo]",
    "tarjetas": ".caja-tarjeta-etiqueta >> nth=0",
    "filtros": "form:has(select[name=tipo])",
    "tabla": "[data-caja-fila] >> nth=0"
   },
   "leer": [
    "main"
   ]
  },
  {
   "accion": "clic",
   "selector": "[data-caja-fila]:has-text('Proveedor Prueba Manual') >> nth=0"
  },
  {
   "accion": "esperar",
