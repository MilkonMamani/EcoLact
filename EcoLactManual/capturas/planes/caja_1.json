  "admin"
 ],
 "pasos": [
  {
   "accion": "ir",
   "url": "/admin/caja",
   "ms": 2500
  },
  {
   "accion": "js",
   "codigo": "document.querySelectorAll('body *').forEach(e=>{ const t=[...e.childNodes].filter(n=>n.nodeType===3).map(n=>n.textContent).join(''); if(t.includes('admin') && t.length<60) e.style.filter='blur(5px)'; })"
  },
  {
   "accion": "captura",
   "nombre": "caj_01_pantalla",
