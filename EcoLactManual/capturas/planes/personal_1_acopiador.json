    {"accion": "clic", "selector": "[data-fichas-panel] button.fichas-editar[data-modal-open^='modal-editar-acopiador']"},
    {"accion": "esperar", "ms": 800},
    {"accion": "escribir", "selector": "[data-modal].is-open input[name=telefono]", "texto": "900000001"},
    {"accion": "captura", "nombre": "per_12_editar", "medir": {"telefono": "[data-modal].is-open input[name=telefono]", "guardar": "[data-modal].is-open button[type=submit]"}, "leer": ["[data-modal].is-open [data-modal-panel]"]},
    {"accion": "clic", "selector": "[data-modal].is-open button[type=submit]"},
