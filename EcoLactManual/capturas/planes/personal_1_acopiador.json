    {"accion": "escribir", "selector": "[data-nuevo-trabajador-form] [name=username]", "texto": "acopiador.duplicado.manual"},
    {"accion": "escribir_secreto", "selector": "[data-nuevo-trabajador-form] [name=password]"},
