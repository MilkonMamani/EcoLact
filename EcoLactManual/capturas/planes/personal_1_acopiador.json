    {"accion": "esperar", "ms": 1500},
    {"accion": "captura", "nombre": "per_13_actualizado", "medir": {"mensaje": "[role=alert]:has-text('actualizado')"}, "leer": ["[role=alert]:has-text('actualizado')"]},

    {"accion": "clic", "selector": "[data-fichas-panel] [data-fichas-tab='zona']"},
    {"accion": "esperar", "ms": 800},
    {"accion": "captura", "nombre": "per_14_tab_zona", "medir": {"tab_zona": "[data-fichas-panel] [data-fichas-tab='zona']", "contenido": "[data-fichas-panel] #ficha-panel-zona", "editar_zona": "[data-fichas-panel] button[data-modal-open^='modal-zona-acopiador']"}, "leer": ["[data-fichas-panel] #ficha-panel-zona"]},
    {"accion": "clic", "selector": "[data-fichas-panel] button[data-modal-open^='modal-zona-acopiador']"},
    {"accion": "esperar", "ms": 800},
    {"accion": "captura", "nombre": "per_15_modal_zona", "medir": {"zona": "[data-modal].is-open select[name=zona_id]", "motivo": "[data-modal].is-open input[name=motivo_cambio_zona]", "guardar": "[data-modal].is-open button[type=submit]"}, "leer": ["[data-modal].is-open [data-modal-panel]"]},
    {"accion": "clic", "selector": "[data-modal].is-open button[data-modal-close]:has-text('Cancelar')"},
    {"accion": "esperar", "ms": 500},

    {"accion": "captura", "nombre": "per_20_antes_desactivar", "medir": {"switch": "[data-fichas-fila]:has-text('Prueba Manual') [role=switch]"}},
    {"accion": "clic", "selector": "[data-fichas-fila]:has-text('Prueba Manual') [role=switch]"},
    {"accion": "esperar", "ms": 800},
    {"accion": "captura", "nombre": "per_21_modal_desactivar", "medir": {"confirmar": "#modal-desactivar-acopiador button[data-desactivar-confirmar]"}, "leer": ["#modal-desactivar-acopiador [data-modal-panel]"]},
    {"accion": "clic", "selector": "#modal-desactivar-acopiador button[data-desactivar-confirmar]"},
    {"accion": "esperar", "ms": 2500},
    {"accion": "captura", "nombre": "per_22_desactivado", "medir": {"switch": "[data-fichas-fila]:has-text('Prueba Manual') [role=switch]", "fila": "[data-fichas-fila]:has-text('Prueba Manual')"}, "leer": ["[data-fichas-fila]:has-text('Prueba Manual')", "body [role=alert], body [role=status]"]},
    {"accion": "clic", "selector": "[data-fichas-fila]:has-text('Prueba Manual') [role=switch]"},
    {"accion": "esperar", "ms": 800},
    {"accion": "seleccionar", "selector": "#reactivar-zona-id", "etiqueta": "Zona Prueba Manual"},
