{"descripcion": "Ventas: venta FICTICIA de 1 unidad de Producto Prueba Manual al Comprador Prueba Manual (contado; ingreso ficticio en Caja), boleta e historial. BD de prueba autorizada.",
 "salida": "evidencias/originales/ventas", "conservar_texto": "Prueba Manual", "difuminar_textos": ["admin"],
 "pasos": [
  {"accion": "ir", "url": "/admin/ventas", "ms": 2500},
  {"accion": "captura", "nombre": "ven_01_pos", "medir": {"tabs": "nav.vpos-tabs", "clientes": "fieldset.vpos-paso >> nth=0"}, "leer": ["[data-vpos-form]"]},
  {"accion": "clic", "selector": "label.vpos-opcion:has(input[value=COMPRADOR])"},
  {"accion": "esperar", "ms": 500},
  {"accion": "escribir", "selector": "[data-vpos-buscador='comprador'] [data-vpos-buscador-texto]", "texto": "Prueba Manual"},
  {"accion": "esperar", "ms": 800},
  {"accion": "captura", "nombre": "ven_02_comprador", "medir": {"cliente": "label.vpos-opcion:has(input[value=COMPRADOR])", "lista": "[data-vpos-buscador='comprador'] [data-vpos-buscador-lista]"}},
  {"accion": "clic", "selector": "[data-vpos-buscador='comprador'] [data-vpos-buscador-lista] >> text=Comprador Prueba Manual"},
  {"accion": "esperar", "ms": 600},
  {"accion": "js", "codigo": "const el=document.querySelector('#vpos-producto'); const o=[...el.options].find(o=>o.text.includes('Producto Prueba Manual')); el.value=o.value; el.dispatchEvent(new Event('change',{bubbles:true}));"},
  {"accion": "esperar", "ms": 600},
  {"accion": "escribir", "selector": "#vpos-cantidad", "texto": "1"},
  {"accion": "esperar", "ms": 1200},
  {"accion": "captura", "nombre": "ven_03_producto", "pagina_completa": true, "medir": {"ficha": "[data-vpos-buscador='comprador'] [data-vpos-buscador-ficha]", "producto": "#vpos-producto", "cantidad": "#vpos-cantidad", "precio": "[data-vpos-precio]", "confirmar": "[data-vpos-confirmar]"}, "leer": ["[data-vpos-form]"]},
  {"accion": "clic", "selector": "[data-vpos-confirmar]"},
  {"accion": "esperar", "ms": 3500},
  {"accion": "captura", "nombre": "ven_04_registrada", "medir": {"aviso": "[data-vpos-ok]", "boleta": "[data-vpos-ver-boleta]"}, "leer": ["[data-vpos-ok]", "[role=alert]"]},
  {"accion": "clic", "selector": "[data-vpos-ver-boleta]"},
  {"accion": "esperar", "ms": 2500},
  {"accion": "captura", "nombre": "ven_05_boleta", "leer": ["body"]},
  {"accion": "ir", "url": "/admin/ventas?tab=historial", "ms": 2500},
  {"accion": "captura", "nombre": "ven_06_historial", "medir": {"tab": "#vpos-tab-historial", "fila": "#vpos-panel-historial tbody tr:has-text('Prueba Manual') >> nth=0"}, "leer": ["#vpos-panel-historial"]}
 ]}
