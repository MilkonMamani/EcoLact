    "ingredientes": "#modal-receta [data-ingredientes]",
    "guardar": "#modal-receta [data-guardar]"
   },
   "leer": [
    "#modal-receta [data-receta-titulo]",
    "#modal-receta [data-nota-modo]",
    "#modal-receta [data-ingredientes]"
   ]
  },
  {
