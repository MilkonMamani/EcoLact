  },
  {
   "accion": "esperar",
   "ms": 600
  },
  {
   "accion": "js",
   "codigo": "const el=document.querySelector(\"#modal-receta [name='ingredientes[1][insumo_id]']\"); const o=[...el.options].find(o=>o.text.trim().startsWith('Insumo Prueba Manual')); el.value=o.value; el.dispatchEvent(new Event('change',{bubbles:true}));"
  },
  {
   "accion": "escribir",
   "selector": "#modal-receta [name='ingredientes[1][cantidad]']",
