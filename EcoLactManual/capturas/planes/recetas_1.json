   "selector": "tbody tr:has-text('Producto Prueba Manual') button[data-receta-accion='editar']"
  },
  {
   "accion": "esperar",
   "ms": 1200
  },
  {
   "accion": "js",
   "codigo": "const c=document.querySelector('#modal-receta [data-ingredientes]'); const s=[...c.querySelectorAll(\"select[name$='[insumo_id]']\")].find(s=>s.selectedOptions[0].text.includes('Insumo Prueba')); const n=s.name.replace('insumo_id','cantidad'); const el=c.querySelector(`[name='${n}']`); el.value='60'; el.dispatchEvent(new Event('input',{bubbles:true})); el.dispatchEvent(new Event('change',{bubbles:true}));"
  },
  {
   "accion": "esperar",
   "ms": 700
  },
  {
   "accion": "captura",
   "nombre": "rec_06_editar",
