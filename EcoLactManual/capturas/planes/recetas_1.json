   }
  },
  {
   "accion": "js",
   "codigo": "const pick=(n,t)=>{const el=document.querySelector(`#modal-receta [name='${n}']`); const o=[...el.options].find(o=>o.text.trim().startsWith(t)); el.value=o.value; el.dispatchEvent(new Event('change',{bubbles:true}));}; pick('ingredientes[0][insumo_id]','Leche');"
  },
  {
   "accion": "escribir",
   "selector": "#modal-receta [name='ingredientes[0][cantidad]']",
